# コピーして使う: cp .env.example .env
# 何も書き換えなくてもそのまま docker compose up で動く

# 音声ファイルの保存先 (local | s3)。当日は local のままでよい
AUDIO_STORE=local

# Postgres (変更不要)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# LocalStack の S3 を使う場合だけ埋める (当日オプション。空のままでよい)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
